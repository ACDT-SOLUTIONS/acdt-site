---
import '@fontsource-variable/instrument-sans/wght.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/geist-mono/wght.css';
import '@/styles/tokens.css';
import '@/styles/base.css';

import Seo from '@/components/seo/Seo.astro';
import Analytics from '@/components/integrations/Analytics.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { estPubliee } from '@/config/publication.mjs';
import { VERSION_PUBLIQUE } from '@/lib/publication';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
// En développement, signale les pages absentes de la version publique (voir src/config/publication.mjs).
const brouillon = !VERSION_PUBLIQUE && !Astro.url.pathname.startsWith('/404') && !estPubliee(Astro.url.pathname);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f7f5f0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Seo title={title} description={description} />
    <slot name="head" />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    {
      brouillon && (
        <p class="brouillon mono">Page non publiée — visible uniquement en développement</p>
      )
    }
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-s);
    background: var(--ink-900);
    color: var(--paper-0);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  .brouillon {
    padding: 0.35rem var(--gutter);
    background: var(--signal-100);
    font-size: var(--step--2);
    letter-spacing: 0.04em;
    text-align: center;
    color: var(--signal-600);
  }
</style>

---
import { getCollection, getEntries } from 'astro:content';
import { lienVisible } from '@/lib/publication';

interface Props {
  /** Limiter aux secteurs liés à une famille. */
  famille?: string;
  /** Afficher aussi les secteurs non publiés, sous forme de carte « En préparation ». */
  avecPreparation?: boolean;
  /** Texte propre à la page qui remplace l'accroche générique, par identifiant de secteur. L'ordre des clés fixe l'ordre d'affichage. */
  textes?: Record<string, string>;
  /** Étapes d'un scénario propre à la page, par identifiant de secteur (mini-parcours numéroté). */
  etapes?: Record<string, string[]>;
  /** Mention affichée en tête de chaque carte, ex. « Scénario illustratif ». */
  badge?: string;
}

const { famille, avecPreparation = false, textes, etapes, badge } = Astro.props;
const ordreImpose = textes ? Object.keys(textes) : null;

const secteurs = (
  await getCollection(
    'secteurs',
    (s) =>
      (avecPreparation || s.data.publie) &&
      (!famille || s.data.familles.some((f) => f.id === famille)) &&
      (!ordreImpose || ordreImpose.includes(s.id)),
  )
).sort((a, b) =>
  ordreImpose ? ordreImpose.indexOf(a.id) - ordreImpose.indexOf(b.id) : a.data.ordre - b.data.ordre,
);
const items = await Promise.all(secteurs.map(async (s) => ({ ...s, familles: await getEntries(s.data.familles) })));
---

<ul class="sectors">
  {
    items.map((s) => {
      const enPreparation = !s.data.publie;
      // Lien vers la page métier uniquement si elle est consultable (publiée, ou en développement).
      const lien = !enPreparation && lienVisible(`/secteurs/${s.id}/`);
      return (
        <li class:list={['sector', { 'sector--pending': enPreparation, 'sector--statique': !enPreparation && !lien }]}>
          {enPreparation && <p class="sector__status mono">En préparation</p>}
          {badge && !enPreparation && <p class="sector__badge mono">{badge}</p>}
          <h3>{lien ? <a href={`/secteurs/${s.id}/`}>{s.data.nom}</a> : s.data.nom}</h3>
          <p class="sector__accroche">{textes?.[s.id] ?? s.data.accroche}</p>
          {etapes?.[s.id] && (
            <ol class="sector__etapes">
              {etapes[s.id].map((e) => (
                <li>{e}</li>
              ))}
            </ol>
          )}
          {s.data.mention && <p class="sector__mention">{s.data.mention}</p>}
          {lien && textes && (
            <p class="sector__lien mono" aria-hidden="true">
              Voir le secteur →
            </p>
          )}
          <p class="sector__familles mono" aria-label="Familles de solutions concernées">
            {s.familles.map((f) => (
              <span title={f.data.titre}>{f.data.numero}</span>
            ))}
          </p>
        </li>
      );
    })
  }
</ul>

<style>
  .sectors {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .sector {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-5) var(--space-5);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-l);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    transition:
      transform var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out);
  }

  .sector:not(.sector--pending, .sector--statique):hover {
    transform: translateY(-3px);
    border-color: var(--color-line-strong);
  }

  .sector:not(.sector--pending, .sector--statique):focus-within {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .sector :focus-visible {
    outline: none;
  }

  h3 {
    font-size: var(--step-2);
  }

  h3 a {
    text-decoration: none;
  }

  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .sector__accroche {
    color: var(--color-text-muted);
  }

  .sector__familles {
    display: flex;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-2);
  }

  .sector__familles span {
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-s);
    background: var(--color-accent-soft);
    font-size: var(--step--2);
    color: var(--color-accent);
  }

  .sector--pending {
    border-style: dashed;
    border-color: var(--color-line-strong);
    background: transparent;
    box-shadow: none;
  }

  .sector--pending h3,
  .sector--pending .sector__accroche {
    color: var(--color-text-muted);
  }

  .sector--pending .sector__familles span {
    background: var(--color-surface-sunken);
    color: var(--color-text-muted);
  }

  .sector__status {
    align-self: flex-start;
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-pill);
    font-size: var(--step--2);
    color: var(--color-text-muted);
  }

  .sector__mention {
    font-size: var(--step--2);
    color: var(--color-text-muted);
  }

  .sector__lien {
    font-size: var(--step--2);
    color: var(--color-accent);
  }

  .sector__badge {
    align-self: flex-start;
    padding: 0.15rem 0.55rem;
    border: 1px dashed var(--signal-500);
    border-radius: var(--radius-pill);
    font-size: var(--step--2);
    color: var(--signal-600);
  }

  /* Mini-parcours : étapes numérotées reliées par un trait. */
  .sector__etapes {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4) 0 0;
    border-top: 1px solid var(--color-line);
    list-style: none;
    counter-reset: etape;
  }

  .sector__etapes li {
    position: relative;
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: center;
    font-size: var(--step--1);
    counter-increment: etape;
  }

  .sector__etapes li::before {
    content: counter(etape);
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border: 1px solid var(--color-accent);
    border-radius: 50%;
    background: var(--color-surface);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--color-accent);
  }

  .sector__etapes li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 1.5rem;
    left: calc(0.75rem - 0.5px);
    height: var(--space-2);
    width: 1px;
    background: var(--color-accent);
    opacity: 0.4;
  }
</style>

---
import { getCollection } from 'astro:content';
import Placeholder from '@/components/ui/Placeholder.astro';
import { formatEuros, formatHeures } from '@/lib/roi/format';
import { chargerScenario } from '@/lib/simulations';

interface Props {
  famille?: string;
  secteur?: string;
}

const { famille, secteur } = Astro.props;
const scenarios = await getCollection(
  'simulations',
  (s) => (!famille || s.data.famille.id === famille) && (!secteur || s.data.secteur.id === secteur),
);
const items = await Promise.all(scenarios.map(chargerScenario));
---

{
  items.length === 0 ? (
    <Placeholder label="À documenter">Aucun cas pratique publié pour l'instant dans cette rubrique.</Placeholder>
  ) : (
    <ul class="cases">
      {items.map(({ scenario, secteur: sec, famille: fam, resultat }) => (
        <li class="case">
          <p class="case__tags mono">
            <span>{sec?.data.nom}</span>
            <span>
              {fam?.data.numero} · {fam?.data.titre}
            </span>
          </p>
          <h3>
            <a href={`/cas-pratiques/${scenario.id}/`}>{scenario.data.titre}</a>
          </h3>
          <dl class="case__chiffres">
            <div>
              <dt>Temps libéré</dt>
              <dd class="mono">{formatHeures(resultat.heuresLibereesParMois)} / mois</dd>
            </div>
            <div>
              <dt>Économies effectives</dt>
              <dd class="mono">{formatEuros(resultat.economiesEffectivesParMois)} / mois</dd>
            </div>
          </dl>
          <p class="case__mention">Scénario chiffré — hypothèses et limites détaillées.</p>
        </li>
      ))}
    </ul>
  )
}

<style>
  .cases {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .case {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-5) var(--space-5);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-l);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .case:hover {
    transform: translateY(-3px);
  }

  .case:focus-within {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .case :focus-visible {
    outline: none;
  }

  .case__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--step--2);
    color: var(--color-text-muted);
  }

  .case__tags span + span::before {
    content: '·';
    margin-right: var(--space-2);
  }

  h3 {
    font-size: var(--step-2);
  }

  h3 a {
    text-decoration: none;
  }

  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .case__chiffres {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
  }

  .case__chiffres dt {
    font-size: var(--step--2);
    color: var(--color-text-muted);
  }

  .case__chiffres dd {
    margin: 0;
    font-size: var(--step-1);
    color: var(--color-accent);
  }

  .case__mention {
    font-size: var(--step--2);
    color: var(--color-text-muted);
  }
</style>

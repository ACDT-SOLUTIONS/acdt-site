---
interface Props {
  etapes: { etape: string; detail: string }[];
  label: string;
}

const { etapes, label } = Astro.props;
---

<ol class="mini-flow" aria-label={label}>
  {
    etapes.map((e, i) => (
      <li class:list={['mini-flow__step', { 'mini-flow__step--final': i === etapes.length - 1 }]}>
        <span class="mini-flow__n mono">{String(i + 1).padStart(2, '0')}</span>
        <span class="mini-flow__etape">{e.etape}</span>
        <span class="mini-flow__detail">{e.detail}</span>
      </li>
    ))
  }
</ol>

<style>
  .mini-flow {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .mini-flow__step {
    position: relative;
    display: grid;
    gap: 0.15rem;
    padding: var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-m);
    background: var(--color-surface);
  }

  /* Connecteur entre étapes */
  .mini-flow__step:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: calc(-1 * var(--space-3));
    width: 1px;
    height: var(--space-3);
    background: var(--color-line-strong);
  }

  .mini-flow__step--final {
    border-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
    background: var(--color-accent-soft);
  }

  .mini-flow__n {
    font-size: var(--step--2);
    color: var(--color-text-subtle);
  }

  .mini-flow__etape {
    font-size: var(--step--1);
    font-weight: 600;
  }

  .mini-flow__detail {
    font-size: var(--step--2);
    color: var(--color-text-muted);
  }

  @media (min-width: 40rem) {
    .mini-flow {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .mini-flow__step:not(:last-child)::after {
      top: 50%;
      left: auto;
      right: calc(-1 * var(--space-3));
      bottom: auto;
      width: var(--space-3);
      height: 1px;
    }
  }
</style>

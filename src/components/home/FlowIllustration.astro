---
// Illustration d'un scénario de la famille 01. Les événements sont fictifs et présentés comme tels.
const evenements = [
  { heure: '18:42', titre: 'Appel entrant', detail: '« Je souhaite un rendez-vous pour un litige commercial. »' },
  { heure: '18:43', titre: 'Motif qualifié', detail: 'Nouveau dossier · droit commercial · non urgent' },
  { heure: '18:43', titre: 'Créneau proposé', detail: "Jeudi 10:00, accepté par l'appelant" },
  { heure: '18:44', titre: 'Équipe informée', detail: 'Fiche créée dans le CRM, résumé envoyé par email' },
];
---

<figure class="flow" aria-labelledby="flow-legende">
  <div class="flow__head mono">
    <span class="flow__live" aria-hidden="true"></span>
    Cabinet fermé · ligne transférée
  </div>

  <ol class="flow__list">
    {
      evenements.map((e, i) => (
        <li class="flow__step" style={`--i: ${i}`}>
          <span class="flow__time mono">{e.heure}</span>
          <span class="flow__node" aria-hidden="true" />
          <div class="flow__body">
            <p class="flow__title">{e.titre}</p>
            <p class="flow__detail">{e.detail}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <figcaption id="flow-legende" class="flow__caption mono">
    <span>Illustration d'un scénario</span>
    <span>01 · Accueil téléphonique IA</span>
  </figcaption>
</figure>

<style>
  .flow {
    --cycle: 9s;
    position: relative;
    display: grid;
    gap: var(--space-5);
    padding: var(--space-5);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-l);
    background: var(--color-surface);
    box-shadow: var(--shadow-float);
  }

  .flow__head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--step--2);
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  .flow__live {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-signal);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-signal) 60%, transparent);
  }

  .flow__list {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  /* Ligne verticale reliant les étapes */
  .flow__list::before {
    content: '';
    position: absolute;
    top: 0.6rem;
    bottom: 0.6rem;
    left: calc(3.1rem + var(--space-3) + 0.3rem - 0.5px);
    width: 1px;
    background: var(--color-line-strong);
  }

  .flow__step {
    display: grid;
    grid-template-columns: 3.1rem 0.6rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
  }

  .flow__time {
    padding-top: 0.15rem;
    font-size: var(--step--2);
    color: var(--color-text-subtle);
  }

  .flow__node {
    position: relative;
    z-index: 1;
    width: 0.6rem;
    height: 0.6rem;
    margin-top: 0.4rem;
    border: 1.5px solid var(--color-line-strong);
    border-radius: 50%;
    background: var(--color-surface);
  }

  .flow__body {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-m);
    background: var(--color-bg);
  }

  .flow__title {
    font-size: var(--step--1);
    font-weight: 600;
  }

  .flow__detail {
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  .flow__caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px dashed var(--color-line-strong);
    font-size: var(--step--2);
    color: var(--color-text-muted);
  }

  /* État « allumé » : statique par défaut, animé en séquence si le mouvement est autorisé. */
  .flow__step .flow__node {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .flow__live {
      animation: pulse 2.4s var(--ease-out) infinite;
    }

    .flow__step {
      animation: step-in var(--cycle) var(--ease-out) infinite;
      animation-delay: calc(var(--i) * 0.9s);
    }

    .flow__step .flow__node {
      animation: node-on var(--cycle) var(--ease-out) infinite;
      animation-delay: calc(var(--i) * 0.9s);
    }
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-signal) 55%, transparent);
    }
    70%,
    100% {
      box-shadow: 0 0 0 0.6rem transparent;
    }
  }

  @keyframes step-in {
    0% {
      opacity: 0.35;
      transform: translateY(4px);
    }
    6%,
    86% {
      opacity: 1;
      transform: none;
    }
    96%,
    100% {
      opacity: 0.35;
    }
  }

  @keyframes node-on {
    0% {
      border-color: var(--color-line-strong);
      background: var(--color-surface);
      box-shadow: none;
    }
    6% {
      border-color: var(--color-signal);
      background: var(--color-signal);
      box-shadow: 0 0 0 4px var(--color-signal-soft);
    }
    20%,
    86% {
      border-color: var(--color-accent);
      background: var(--color-accent);
      box-shadow: none;
    }
    96%,
    100% {
      border-color: var(--color-line-strong);
      background: var(--color-surface);
    }
  }
</style>

---
import { getCollection } from 'astro:content';
import { lienEvaluation } from '@/config/site';

// Porte d'entrée vers les rubriques : uniquement des repères de navigation, pas le détail des offres.
const solutions = (await getCollection('solutions')).sort((a, b) => a.data.numero.localeCompare(b.data.numero));
const secteurs = (await getCollection('secteurs', (s) => s.data.publie)).sort((a, b) => a.data.ordre - b.data.ordre);
const cas = await getCollection('simulations');

const rubriques = [
  {
    href: '/solutions/',
    titre: 'Solutions',
    texte: 'Quatre familles de solutions, construites à partir de vos problèmes métier.',
    reperes: solutions.map((s) => s.data.numero),
    compteur: `${solutions.length} familles`,
  },
  {
    href: '/secteurs/',
    titre: "Secteurs d'activité",
    texte: 'Les solutions appliquées aux contraintes de votre profession.',
    reperes: secteurs.map((s) => s.data.nom),
    compteur: `${secteurs.length} secteurs`,
  },
  {
    href: '/cas-pratiques/',
    titre: 'Cas pratiques',
    texte: 'Des scénarios chiffrés, avec leurs hypothèses, leurs sources et leurs limites.',
    reperes: [],
    compteur: `${cas.length} ${cas.length > 1 ? 'scénarios' : 'scénario'}`,
  },
];
---

<ul class="orientation">
  {
    rubriques.map((r, i) => (
      <li class="rubrique">
        <div class="rubrique__top">
          <span class="rubrique__index mono">{String(i + 1).padStart(2, '0')}</span>
          <span class="rubrique__compteur mono">{r.compteur}</span>
        </div>
        <h3>
          <a href={r.href}>{r.titre}</a>
        </h3>
        <p class="rubrique__texte">{r.texte}</p>
        {r.reperes.length > 0 && (
          <ul class="rubrique__reperes mono" aria-hidden="true">
            {r.reperes.map((x) => (
              <li>{x}</li>
            ))}
          </ul>
        )}
        {r.href === '/cas-pratiques/' && (
          <a class="rubrique__secondaire" href={lienEvaluation.href}>
            {lienEvaluation.label}
          </a>
        )}
        <span class="rubrique__fleche" aria-hidden="true">
          →
        </span>
      </li>
    ))
  }
</ul>

<style>
  .orientation {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .rubrique {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-height: 19rem;
    padding: var(--space-6);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-l);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    transition:
      transform var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out);
  }

  .rubrique:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
  }

  .rubrique:focus-within {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .rubrique :focus-visible {
    outline: none;
  }

  .rubrique__top {
    display: flex;
    justify-content: space-between;
    font-size: var(--step--2);
  }

  .rubrique__index {
    color: var(--signal-600);
  }

  .rubrique__compteur {
    color: var(--color-text-muted);
  }

  h3 {
    font-size: var(--step-3);
  }

  h3 a {
    text-decoration: none;
  }

  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .rubrique__texte {
    color: var(--color-text-muted);
  }

  .rubrique__reperes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .rubrique__reperes li {
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-s);
    background: var(--color-accent-soft);
    font-size: var(--step--2);
    color: var(--color-accent);
  }

  /* Lien secondaire placé au-dessus du lien étendu de la carte */
  .rubrique__secondaire {
    position: relative;
    z-index: 1;
    align-self: flex-start;
    font-size: var(--step--1);
    color: var(--color-accent);
  }

  .rubrique__secondaire:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .rubrique__fleche {
    margin-top: auto;
    font-size: var(--step-2);
    color: var(--color-accent);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .rubrique:hover .rubrique__fleche {
    transform: translateX(6px);
  }
</style>

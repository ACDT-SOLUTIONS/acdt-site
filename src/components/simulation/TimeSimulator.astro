---
import type { CollectionEntry } from 'astro:content';
import SimulatorField from './SimulatorField.astro';
import { formatHeures, formatNombre } from '@/lib/roi/format';
import { CLES_ECONOMIE, estimer } from '@/lib/roi/saisie';

type Valeur = NonNullable<CollectionEntry<'pagesSecteurs'>['data']['valeur']>;

interface Props {
  simulateur: Valeur['simulateur'];
  resultats: Valeur['resultats'];
  economie: Valeur['economie'];
}

// Simulateur de temps libéré, scénario par scénario, dans la présentation du calculateur de
// /evaluer-le-potentiel/ (curseurs, cartes de résultats, barres comparatives). Tout est calculé dans le
// navigateur par `simuler()` : aucune valeur saisie n'est envoyée, enregistrée ni mesurée.
// Sans JavaScript, seul un message s'affiche.
const { simulateur, resultats, economie } = Astro.props;

// En français, « heure » reste au singulier en dessous de 2.
const parSemaine = (heures: number) =>
  (heures < 2 ? resultats.parSemaineSingulier : resultats.parSemaine).replace('{valeur}', formatNombre(heures));
const largeur = (part: number, total: number) => `${total > 0 ? Math.max(0, Math.min(100, (part / total) * 100)) : 0}%`;

const scenarios = simulateur.scenarios.map((s) => {
  const r = estimer({
    occurrencesParMois: s.volume.valeur,
    minutesParOccurrence: s.minutes.valeur,
    tauxAutomatisation: s.part.valeur / 100,
  }).temps!;
  return {
    ...s,
    champs: [
      { cle: 'occurrencesParMois', ...s.volume },
      { cle: 'minutesParOccurrence', ...s.minutes },
      { cle: 'tauxAutomatisation', ...s.part },
    ] as const,
    r,
  };
});

const textes = {
  parSemaine: resultats.parSemaine,
  parSemaineSingulier: resultats.parSemaineSingulier,
  libere: resultats.libere,
  eco: economie.resultats,
};
const r = economie.resultats;
---

<simulateur-temps class="sim" data-textes={JSON.stringify(textes)}>
  <p class="sim__sans-js" data-sans-js>{simulateur.sansJs}</p>

  <div class="sim__carte" data-interactif hidden>
    <div class="sim__tete">
      <div class="sim__onglets" role="tablist" aria-label={simulateur.libelleOnglets}>
        {
          scenarios.map((s, i) => (
            <button
              class="sim__onglet"
              type="button"
              role="tab"
              id={`sim-onglet-${s.id}`}
              aria-controls={`sim-panneau-${s.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              <span class="mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              {s.label}
            </button>
          ))
        }
      </div>
    </div>

    {
      scenarios.map((s, i) => (
        <form
          class="sim__panneau"
          id={`sim-panneau-${s.id}`}
          role="tabpanel"
          aria-labelledby={`sim-onglet-${s.id}`}
          data-label={s.label}
          hidden={i > 0}
          novalidate
        >
          <div class="sim__corps">
            <fieldset class="sim__col sim__col--params">
              <legend class="sim__soustitre mono">{simulateur.hypotheses}</legend>
              {s.champs.map((c) => (
                <SimulatorField
                  id={`sim-${s.id}-${c.cle}`}
                  cle={c.cle}
                  label={c.label}
                  unite={c.unite}
                  valeur={c.valeur}
                  curseur={c.curseur}
                  aide={c.aide}
                />
              ))}
              <p class="sim__avertissement">{simulateur.avertissement}</p>
              <button type="button" class="sim__reset mono" data-reset>
                <span aria-hidden="true">↺</span> {simulateur.reinitialiser}
              </button>
            </fieldset>

            <div class="sim__col">
              <h3 class="sim__soustitre mono">{resultats.titre}</h3>
              <div data-temps>
                <ol class="metrics">
                  <li class="metric metric--cle metric--large">
                    <p class="metric__label">
                      <span class="mono">1</span>
                      <span class="metric__titre">{resultats.libere}</span>
                    </p>
                    <p class="metric__value mono">
                      <span data-out="libere">{formatHeures(s.r.libere)}</span>
                      <small> / mois</small>
                    </p>
                    <p class="metric__def metric__semaine" data-out="parSemaine">
                      {parSemaine(s.r.libereParSemaine)}
                    </p>
                    <p class="metric__note mono">{resultats.baseSemaine}</p>
                  </li>
                  <li class="metric">
                    <p class="metric__label">
                      <span class="mono">2</span>
                      <span class="metric__titre">{resultats.actuel}</span>
                    </p>
                    <p class="metric__value mono">
                      <span data-out="actuel">{formatHeures(s.r.actuel)}</span>
                      <small> / mois</small>
                    </p>
                  </li>
                  <li class="metric">
                    <p class="metric__label">
                      <span class="mono">3</span>
                      <span class="metric__titre">{resultats.restant}</span>
                    </p>
                    <p class="metric__value mono">
                      <span data-out="restant">{formatHeures(s.r.restant)}</span>
                      <small> / mois</small>
                    </p>
                  </li>
                </ol>

                <div class="cascade" aria-hidden="true">
                  <div class="cascade__row">
                    <span class="cascade__label">{resultats.barres.actuel}</span>
                    <span class="cascade__bar">
                      <span style="width: 100%" data-barre="actuel" />
                    </span>
                    <span class="cascade__val mono" data-out="actuel">
                      {formatHeures(s.r.actuel)}
                    </span>
                  </div>
                  <div class="cascade__row cascade__row--cle">
                    <span class="cascade__label">{resultats.barres.libere}</span>
                    <span class="cascade__bar">
                      <span style={`width: ${largeur(s.r.libere, s.r.actuel)}`} data-barre="libere" />
                    </span>
                    <span class="cascade__val mono" data-out="libere">
                      {formatHeures(s.r.libere)}
                    </span>
                  </div>
                  <div class="cascade__row">
                    <span class="cascade__label">{resultats.barres.restant}</span>
                    <span class="cascade__bar">
                      <span style={`width: ${largeur(s.r.restant, s.r.actuel)}`} data-barre="restant" />
                    </span>
                    <span class="cascade__val mono" data-out="restant">
                      {formatHeures(s.r.restant)}
                    </span>
                  </div>
                </div>
              </div>
              <p
                class="sim__etat"
                data-etat
                data-incomplet={resultats.incomplet}
                data-invalide={resultats.invalide}
                hidden
              />
              <p class="sim__separe">{resultats.separe}</p>
            </div>
          </div>

          <details class="sim__eco">
            <summary>
              <span>{economie.titre}</span>
              <span class="sim__eco-icone" aria-hidden="true" />
            </summary>
            <p class="sim__eco-intro">{economie.intro}</p>
            <div class="sim__corps">
              <fieldset class="sim__col sim__col--params">
                <legend class="visually-hidden">{economie.titre}</legend>
                {CLES_ECONOMIE.map((cle) => (
                  <SimulatorField id={`sim-${s.id}-${cle}`} cle={cle} aSaisir={economie.aSaisir} {...economie.champs[cle]} />
                ))}
              </fieldset>

              <div class="sim__col">
                <p class="sim__eco-avertissement">{economie.avertissement}</p>
                <ol class="metrics">
                  <li class="metric" data-carte="valorisation" data-vide>
                    <p class="metric__label">
                      <span class="mono">1</span>
                      <span class="metric__titre">
                        {r.valorisation} <span class="metric__badge mono">{economie.badgeTheorique}</span>
                      </span>
                    </p>
                    <p class="metric__value mono">
                      <span data-eco="valorisation">—</span>
                      <small> / mois</small>
                    </p>
                  </li>
                  <li class="metric metric--cle" data-carte="soldeMensuel" data-vide>
                    <p class="metric__label">
                      <span class="mono">2</span>
                      <span class="metric__titre">{r.soldeMensuel}</span>
                    </p>
                    <p class="metric__value mono">
                      <span data-eco="soldeMensuel">—</span>
                      <small> / mois</small>
                    </p>
                  </li>
                  <li class="metric metric--cle metric--large" data-carte="soldeCumule" data-vide>
                    <p class="metric__label">
                      <span class="mono">3</span>
                      <span class="metric__titre">{r.soldeCumule}</span>
                    </p>
                    <p class="metric__value mono">
                      <span data-eco="soldeCumule">—</span>
                      <small class="metric__horizon" data-eco="horizon" />
                    </p>
                    <p class="metric__def">
                      <span data-ligne="ratio" hidden>
                        {r.ratio} : <strong class="mono" data-eco="ratio" />.
                      </span>{' '}
                      <span data-ligne="delai" hidden>
                        <span data-eco="delai" />
                      </span>
                    </p>
                  </li>
                </ol>

                <div class="cascade" aria-hidden="true" data-cascade-eco hidden>
                  <div class="cascade__row">
                    <span class="cascade__label">{economie.barres.valorisation}</span>
                    <span class="cascade__bar">
                      <span style="width: 100%" data-barre="valorisation" />
                    </span>
                    <span class="cascade__val mono" data-eco="valorisation" />
                  </div>
                  <div class="cascade__row">
                    <span class="cascade__label">{economie.barres.evitee}</span>
                    <span class="cascade__bar">
                      <span data-barre="evitee" />
                    </span>
                    <span class="cascade__val mono" data-eco="evitee" />
                  </div>
                  <div class="cascade__row cascade__row--cle">
                    <span class="cascade__label">{economie.barres.solde}</span>
                    <span class="cascade__bar">
                      <span data-barre="solde" />
                    </span>
                    <span class="cascade__val mono" data-eco="soldeMensuel" />
                  </div>
                </div>

                <p class="sim__eco-attente" data-eco-attente data-textes={JSON.stringify(economie.attente)}>
                  {economie.attente.valorisation}
                </p>
              </div>
            </div>
          </details>
        </form>
      ))
    }

    <p class="visually-hidden" aria-live="polite" data-annonce></p>
  </div>
</simulateur-temps>

<script>
  import { formatEuros, formatHeures, formatMois, formatNombre, formatPourcent } from '@/lib/roi/format';
  import { CLES_TEMPS, estimer, lireChamp, lireNombre, type Cle, type Estimation } from '@/lib/roi/saisie';

  interface Textes {
    parSemaine: string;
    parSemaineSingulier: string;
    libere: string;
    eco: Record<'valorisation' | 'soldeMensuel' | 'soldeCumule' | 'ratio' | 'delai' | 'aucunRetour' | 'sansInvestissement', string>;
  }

  // Évite d'afficher « -0 € » pour un solde qui n'est négatif qu'à l'arrondi près.
  const euros = (v: number) => formatEuros(Math.abs(v) < 0.005 ? 0 : v);
  const largeur = (part: number, total: number) =>
    `${total > 0 ? Math.max(0, Math.min(100, (part / total) * 100)) : 0}%`;

  class SimulateurTemps extends HTMLElement {
    private textes!: Textes;
    private annonce: HTMLElement | null = null;
    private minuteur?: number;

    connectedCallback() {
      this.textes = JSON.parse(this.dataset.textes ?? '{}');
      this.annonce = this.querySelector('[data-annonce]');
      this.querySelector<HTMLElement>('[data-sans-js]')!.hidden = true;
      this.querySelector<HTMLElement>('[data-interactif]')!.hidden = false;

      const onglets = [...this.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const panneaux = [...this.querySelectorAll<HTMLFormElement>('[role="tabpanel"]')];

      // Chaque scénario a son propre formulaire : ses valeurs restent en place d'un onglet à l'autre.
      const choisir = (index: number, focus = false) => {
        onglets.forEach((o, i) => {
          const actif = i === index;
          o.setAttribute('aria-selected', String(actif));
          o.tabIndex = actif ? 0 : -1;
          panneaux[i].hidden = !actif;
        });
        if (focus) onglets[index].focus();
      };

      onglets.forEach((o, i) => {
        o.addEventListener('click', () => choisir(i));
        o.addEventListener('keydown', (e) => {
          const dernier = onglets.length - 1;
          const cible =
            e.key === 'ArrowRight' ? (i === dernier ? 0 : i + 1)
            : e.key === 'ArrowLeft' ? (i === 0 ? dernier : i - 1)
            : e.key === 'Home' ? 0
            : e.key === 'End' ? dernier
            : null;
          if (cible === null) return;
          e.preventDefault();
          choisir(cible, true);
        });
      });

      panneaux.forEach((panneau) => {
        panneau.addEventListener('submit', (e) => e.preventDefault());
        panneau.addEventListener('input', (e) => {
          this.synchroniser(e.target as HTMLInputElement);
          this.calculer(panneau, true);
        });
        panneau.querySelector('[data-reset]')?.addEventListener('click', () => {
          panneau.querySelectorAll<HTMLInputElement>('input[data-cle]').forEach((input) => {
            input.value = input.dataset.initial ?? '';
            this.synchroniser(input);
          });
          this.calculer(panneau, true);
        });
        this.calculer(panneau, false);
      });
    }

    // Le curseur et la valeur affichée à côté se suivent l'un l'autre.
    private synchroniser(source: HTMLInputElement) {
      const champ = source.closest('.champ');
      const texte = champ?.querySelector<HTMLInputElement>('input[data-cle]');
      const curseur = champ?.querySelector<HTMLInputElement>('[data-curseur]');
      if (!texte || !curseur) return;
      if (source === curseur) {
        texte.value = curseur.value.replace('.', ',');
      } else {
        const n = lireNombre(texte.value);
        if (n !== null && Number.isFinite(n)) curseur.value = String(n);
      }
      const unite = champ?.querySelector('.champ__unite')?.textContent ?? '';
      curseur.setAttribute('aria-valuetext', `${texte.value || '—'} ${unite}`);
    }

    private calculer(panneau: HTMLFormElement, annoncer: boolean) {
      const valeurs: Partial<Record<Cle, number | null>> = {};
      let tempsInvalide = false;
      let ecoInvalide = false;

      panneau.querySelectorAll<HTMLInputElement>('input[data-cle]').forEach((input) => {
        const cle = input.dataset.cle as Cle;
        const { valeur, erreur } = lireChamp(cle, input.value);
        valeurs[cle] = valeur;
        const message = input.closest('.champ')?.querySelector('[data-erreur]');
        if (message) message.textContent = erreur ?? '';
        if (erreur) input.setAttribute('aria-invalid', 'true');
        else input.removeAttribute('aria-invalid');
        if (erreur && (CLES_TEMPS as readonly string[]).includes(cle)) tempsInvalide = true;
        else if (erreur) ecoInvalide = true;
      });

      const e = estimer(valeurs);
      this.afficherTemps(panneau, e, tempsInvalide);
      this.afficherEconomie(panneau, e, ecoInvalide, valeurs.horizonMois ?? null);

      if (annoncer) this.annoncer(panneau, e);
    }

    private afficherTemps(panneau: HTMLElement, e: Estimation, invalide: boolean) {
      const bloc = panneau.querySelector<HTMLElement>('[data-temps]')!;
      const etat = panneau.querySelector<HTMLElement>('[data-etat]')!;
      bloc.hidden = !e.temps;
      etat.hidden = Boolean(e.temps);
      etat.textContent = (invalide ? etat.dataset.invalide : etat.dataset.incomplet) ?? '';
      if (!e.temps) return;

      const t = e.temps;
      this.ecrire(panneau, '[data-out="libere"]', formatHeures(t.libere));
      this.ecrire(panneau, '[data-out="parSemaine"]', this.parSemaine(t.libereParSemaine));
      this.ecrire(panneau, '[data-out="actuel"]', formatHeures(t.actuel));
      this.ecrire(panneau, '[data-out="restant"]', formatHeures(t.restant));
      this.barre(panneau, 'actuel', t.actuel > 0 ? '100%' : '0%');
      this.barre(panneau, 'libere', largeur(t.libere, t.actuel));
      this.barre(panneau, 'restant', largeur(t.restant, t.actuel));
    }

    private afficherEconomie(panneau: HTMLElement, e: Estimation, invalide: boolean, horizon: number | null) {
      const eco = this.textes.eco;
      const attente = panneau.querySelector<HTMLElement>('[data-eco-attente]')!;
      const messages = JSON.parse(attente.dataset.textes ?? '{}');
      // Une saisie invalide masque tous les résultats économiques plutôt que d'en afficher une partie trompeuse.
      const ok = Boolean(e.temps) && !invalide;
      const v = <T,>(x: T | null) => (ok ? x : null);

      const carte = (nom: string, valeur: number | null) => {
        const el = panneau.querySelector<HTMLElement>(`[data-carte="${nom}"]`)!;
        el.toggleAttribute('data-vide', valeur === null);
        el.toggleAttribute('data-negatif', valeur !== null && valeur < -0.005);
        this.ecrire(el, `[data-eco="${nom}"]`, valeur === null ? '—' : euros(valeur));
      };
      carte('valorisation', v(e.valorisation));
      carte('soldeMensuel', v(e.soldeMensuel));
      carte('soldeCumule', v(e.soldeCumule));
      this.ecrire(
        panneau,
        '[data-eco="horizon"]',
        v(e.soldeCumule) === null || horizon === null ? '' : `sur ${formatNombre(horizon)} mois`,
      );

      const ratio = panneau.querySelector<HTMLElement>('[data-ligne="ratio"]')!;
      ratio.hidden = v(e.ratio) === null || v(e.soldeCumule) === null;
      if (!ratio.hidden) this.ecrire(ratio, '[data-eco="ratio"]', formatPourcent(e.ratio));

      const delai = panneau.querySelector<HTMLElement>('[data-ligne="delai"]')!;
      delai.hidden = v(e.soldeCumule) === null;
      delai.toggleAttribute('data-negatif', e.delaiRetour === null);
      this.ecrire(
        delai,
        '[data-eco="delai"]',
        e.delaiRetour === null ? `${eco.aucunRetour}.`
        : e.delaiRetour === 0 ? `${eco.sansInvestissement}.`
        : `${eco.delai} : ${formatMois(e.delaiRetour)}.`,
      );

      // Barres : de la valorisation théorique au solde mensuel, à partir du palier « solde mensuel ».
      const cascade = panneau.querySelector<HTMLElement>('[data-cascade-eco]')!;
      cascade.hidden = v(e.soldeMensuel) === null;
      if (!cascade.hidden && e.valorisation !== null && e.valeurEvitee !== null && e.soldeMensuel !== null) {
        this.ecrire(cascade, '[data-eco="valorisation"]', euros(e.valorisation));
        this.ecrire(cascade, '[data-eco="evitee"]', euros(e.valeurEvitee));
        this.ecrire(cascade, '[data-eco="soldeMensuel"]', euros(e.soldeMensuel));
        this.barre(cascade, 'valorisation', e.valorisation > 0 ? '100%' : '0%');
        this.barre(cascade, 'evitee', largeur(e.valeurEvitee, e.valorisation));
        this.barre(cascade, 'solde', largeur(e.soldeMensuel, e.valorisation));
        cascade.toggleAttribute('data-negatif', e.soldeMensuel < -0.005);
      }

      const message =
        !e.temps ? ''
        : invalide ? (panneau.querySelector<HTMLElement>('[data-etat]')?.dataset.invalide ?? '')
        : e.valorisation === null ? messages.valorisation
        : e.soldeMensuel === null ? messages.soldeMensuel
        : e.soldeCumule === null ? messages.soldeCumule
        : '';
      attente.textContent = message;
      attente.hidden = message === '';
    }

    // Annonce discrète, après une courte pause de saisie, pour ne pas lire chaque frappe.
    private annoncer(panneau: HTMLElement, e: Estimation) {
      window.clearTimeout(this.minuteur);
      this.minuteur = window.setTimeout(() => {
        if (!this.annonce) return;
        const etat = panneau.querySelector<HTMLElement>('[data-etat]');
        if (!e.temps) {
          this.annonce.textContent = etat?.textContent ?? '';
          return;
        }
        const phrases = [
          `${panneau.dataset.label} : ${this.textes.libere.toLowerCase()}, ${formatHeures(e.temps.libere)}.`,
          `${this.parSemaine(e.temps.libereParSemaine)}.`,
        ];
        if (e.soldeMensuel !== null) phrases.push(`${this.textes.eco.soldeMensuel} : ${euros(e.soldeMensuel)} par mois.`);
        this.annonce.textContent = phrases.join(' ');
      }, 800);
    }

    private parSemaine(heures: number) {
      const modele = heures < 2 ? this.textes.parSemaineSingulier : this.textes.parSemaine;
      return modele.replace('{valeur}', formatNombre(heures));
    }

    private barre(racine: HTMLElement, nom: string, valeur: string) {
      const el = racine.querySelector<HTMLElement>(`[data-barre="${nom}"]`);
      if (el) el.style.width = valeur;
    }

    private ecrire(racine: HTMLElement, selecteur: string, texte: string) {
      racine.querySelectorAll(selecteur).forEach((el) => (el.textContent = texte));
    }
  }

  customElements.define('simulateur-temps', SimulateurTemps);
</script>

<style>
  .sim__sans-js {
    padding: var(--space-5) var(--space-6);
    border: 1px dashed var(--color-line-strong);
    border-radius: var(--radius-l);
    background: var(--color-surface);
    color: var(--color-text-muted);
  }

  /* Carte sombre, comme le calculateur de /evaluer-le-potentiel/. */
  .sim__carte {
    border: 1px solid var(--color-inverse-line);
    border-radius: var(--radius-l);
    background: var(--color-inverse-surface);
    color: var(--color-inverse-text);
    overflow: hidden;
  }

  .sim__tete {
    padding: var(--space-5) var(--space-6);
    border-bottom: 1px solid var(--color-inverse-line);
  }

  .sim__onglets {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: var(--space-1);
    border: 1px solid var(--color-inverse-line);
    border-radius: var(--radius-pill);
  }

  .sim__onglet {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    font-size: var(--step--1);
    color: var(--color-inverse-muted);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .sim__onglet .mono {
    font-size: var(--step--2);
    opacity: 0.7;
  }

  .sim__onglet:hover {
    color: var(--color-inverse-text);
  }

  .sim__onglet[aria-selected='true'] {
    background: var(--color-inverse-text);
    color: var(--ink-950);
  }

  .sim__onglet:focus-visible {
    outline-color: var(--signal-300);
  }


---
import { PUBLIC_PLAUSIBLE_DOMAIN, PUBLIC_PLAUSIBLE_SRC } from 'astro:env/server';

// Plausible seul, sans cookie : chargé uniquement en build de production et si configuré.
// Rien n'est envoyé pendant le développement local.
const actif = import.meta.env.PROD && PUBLIC_PLAUSIBLE_DOMAIN && PUBLIC_PLAUSIBLE_SRC;
---

{actif && <script is:inline defer data-domain={PUBLIC_PLAUSIBLE_DOMAIN} src={PUBLIC_PLAUSIBLE_SRC} />}

---
import { PUBLIC_FORMULAIRE_URL } from 'astro:env/server';
import { lienEffectif } from '@/lib/publication';

// Formulaire de contact (même format que l'ancien formulaire n8n : name, company, email, message, formId).
// Désactivé tant que PUBLIC_FORMULAIRE_URL n'est pas défini : rien n'est affiché ni envoyé.
// Tests : endpoint local (npm run formulaire:test), jamais le webhook de production sans validation.
const lienConfidentialite = lienEffectif('/politique-de-confidentialite/');
---

{
  PUBLIC_FORMULAIRE_URL && (
    <contact-form data-url={PUBLIC_FORMULAIRE_URL}>
      <form class="formulaire" novalidate>
        <div class="champ">
          <label for="cf-nom">Nom</label>
          <input id="cf-nom" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="champ">
          <label for="cf-societe">
            Société <span>(facultatif)</span>
          </label>
          <input id="cf-societe" name="company" type="text" autocomplete="organization" />
        </div>
        <div class="champ">
          <label for="cf-email">Email</label>
          <input id="cf-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="champ">
          <label for="cf-message">Message</label>
          <textarea id="cf-message" name="message" rows="6" required />
        </div>
        <div class="piege" aria-hidden="true">
          <label for="cf-site">Ne pas remplir</label>
          <input id="cf-site" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        {
          lienConfidentialite && (
            <p class="mention">
              Vos données servent uniquement à répondre à votre demande.{' '}
              <a href={lienConfidentialite}>Politique de confidentialité</a>.
            </p>
          )
        }
        <button type="submit">Envoyer</button>
        <p class="statut" role="status" aria-live="polite"></p>
      </form>
    </contact-form>
  )
}

<script>
  class ContactForm extends HTMLElement {
    connectedCallback() {
      const form = this.querySelector('form');
      const statut = this.querySelector<HTMLElement>('.statut');
      const bouton = this.querySelector<HTMLButtonElement>('button[type="submit"]');
      const url = this.dataset.url;
      if (!form || !statut || !bouton || !url) return;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const donnees = Object.fromEntries(new FormData(form)) as Record<string, string>;
        if (donnees.website) return; // champ piège rempli : envoi ignoré

        bouton.disabled = true;
        statut.textContent = 'Envoi en cours…';
        try {
          const reponse = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ...donnees, formId: 'contact_v2' }),
          });
          if (!reponse.ok) throw new Error(`HTTP ${reponse.status}`);
          form.reset();
          statut.textContent = 'Merci, votre message a bien été envoyé.';
        } catch {
          statut.textContent = "L'envoi a échoué. Vous pouvez nous écrire directement par email.";
        } finally {
          bouton.disabled = false;
        }
      });
    }
  }

  customElements.define('contact-form', ContactForm);
</script>

<style>
  .formulaire {
    display: grid;
    gap: var(--space-4);
  }

  .champ {
    display: grid;
    gap: var(--space-2);
  }

  label {
    font-size: var(--step--1);
    font-weight: 560;
  }

  label span {
    font-weight: 400;
    color: var(--color-text-muted);
  }

  input,
  textarea {
    width: 100%;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-m);
    background: var(--color-surface);
  }

  input:focus-visible,
  textarea:focus-visible {
    border-color: var(--color-accent);
  }

  .piege {
    position: absolute;
    left: -9999px;
  }

  .mention {
    font-size: var(--step--2);
    color: var(--color-text-muted);
  }

  button {
    justify-self: start;
    min-height: 2.75rem;
    padding: 0.7rem 1.4rem;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    font-weight: 560;
    color: var(--color-on-accent);
  }

  button:disabled {
    opacity: 0.6;
  }

  .statut {
    min-height: 1.5em;
    font-size: var(--step--1);
  }
</style>

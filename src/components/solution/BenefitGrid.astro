---
interface Props {
  items: { label: string; titre: string; texte: string }[];
}
---

<ul class="benefits">
  {
    Astro.props.items.map((b) => (
      <li class="benefit">
        <p class="benefit__label mono">{b.label}</p>
        <h3>{b.titre}</h3>
        <p class="benefit__texte">{b.texte}</p>
      </li>
    ))
  }
</ul>

<style>
  .benefits {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-6) var(--space-5);
    padding: 0;
    list-style: none;
  }

  .benefit {
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: var(--space-3);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line-strong);
  }

  .benefit__label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .benefit__label::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-accent);
  }

  h3 {
    font-size: var(--step-1);
    line-height: 1.2;
  }

  .benefit__texte {
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }
</style>

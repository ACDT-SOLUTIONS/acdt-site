---
interface Props {
  etapes: { titre: string; texte: string }[];
  label: string;
}

// Schéma de fonctionnement en étapes reliées : horizontal sur grand écran, vertical sur mobile.
const { etapes, label } = Astro.props;
---

<ol class="process" aria-label={label} style={`--n: ${etapes.length}`}>
  {
    etapes.map((e, i) => (
      <li class:list={['process__step', { 'process__step--final': i === etapes.length - 1 }]}>
        <span class="process__node mono" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <div class="process__body">
          <p class="process__label mono">Étape {i + 1}</p>
          <h3>{e.titre}</h3>
          <p>{e.texte}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .process {
    position: relative;
    display: grid;
    gap: var(--space-5);
    padding: 0;
    list-style: none;
  }

  .process__step {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: var(--space-4);
  }

  /* Connecteur vertical (mobile) */
  .process__step:not(:last-child)::before {
    content: '';
    position: absolute;
    top: 2.75rem;
    bottom: calc(-1 * var(--space-5));
    left: calc(1.375rem - 0.5px);
    width: 1px;
    background: var(--color-line-strong);
  }

  .process__node {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 50%;
    background: var(--color-surface);
    font-size: var(--step--1);
  }

  .process__step--final .process__node {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .process__body {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5) var(--space-5);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-m);
    background: var(--color-surface);
  }

  .process__step--final .process__body {
    border-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
    background: var(--color-accent-soft);
  }

  .process__label {
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  h3 {
    font-size: var(--step-1);
    line-height: 1.2;
  }

  .process__body p:last-child {
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  @media (min-width: 64rem) {
    .process {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
      gap: var(--space-4);
    }

    .process__step {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
    }

    /* Connecteur horizontal entre les pastilles */
    .process__step:not(:last-child)::before {
      top: calc(1.375rem - 0.5px);
      bottom: auto;
      left: 2.75rem;
      right: calc(-1 * var(--space-4));
      width: auto;
      height: 1px;
    }
  }
</style>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/layout/PageHero.astro';
import Section from '@/components/layout/Section.astro';
import CtaBand from '@/components/layout/CtaBand.astro';
import { lienEvaluation } from '@/config/site';
import { lienEffectif } from '@/lib/publication';

// Contenus déjà en ligne uniquement : ne pas annoncer de blog, de guide ou de publication future.
const ressources = [
  {
    titre: 'Cas pratiques',
    texte: 'Des scénarios chiffrés, avec leurs hypothèses, leurs calculs et leurs limites.',
    href: '/cas-pratiques/',
  },
  {
    titre: lienEvaluation.label,
    texte: 'Un outil pour tester vos propres hypothèses de volume, de durée et de coût.',
    href: lienEvaluation.href,
  },
  {
    titre: 'Notre méthode',
    texte: "Les étapes d'un projet, du premier échange à la mesure des résultats.",
    href: '/methode/',
  },
]
  .map((r) => ({ ...r, href: lienEffectif(r.href) }))
  .filter((r): r is typeof r & { href: string } => Boolean(r.href));
---

<BaseLayout title="Ressources" description="Repères pour préparer un projet d'automatisation.">
  <PageHero eyebrow="Ressources" breadcrumbs={[{ label: 'Ressources', href: '/ressources/' }]}>
    <Fragment slot="title">Repères pour préparer <em class="accent">un projet d'automatisation.</em></Fragment>
    Retrouvez nos scénarios chiffrés, la méthode d'analyse et l'outil qui permet de tester vos propres hypothèses. Les
    exemples sont des simulations, pas des résultats clients.
  </PageHero>

  <Section labelledby="ressources-titre">
    <h2 id="ressources-titre" class="visually-hidden">Ressources disponibles</h2>
    <ul class="ressources">
      {
        ressources.map((r) => (
          <li>
            <h3>
              <a href={r.href}>{r.titre}</a>
            </h3>
            <p>{r.texte}</p>
            <span class="ressources__fleche mono" aria-hidden="true">
              →
            </span>
          </li>
        ))
      }
    </ul>
  </Section>

  <CtaBand />
</BaseLayout>

<style>
  .ressources {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .ressources li {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-l);
    background: var(--color-surface);
    transition: border-color var(--duration-base) var(--ease-out);
  }

  .ressources li:hover {
    border-color: var(--color-accent);
  }

  .ressources li:focus-within {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .ressources h3 {
    font-size: var(--step-1);
    line-height: 1.2;
  }

  .ressources a {
    text-decoration: none;
  }

  .ressources a:focus-visible {
    outline: none;
  }

  .ressources a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .ressources p {
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  .ressources__fleche {
    color: var(--color-accent);
  }
</style>

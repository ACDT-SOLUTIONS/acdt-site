---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/layout/PageHero.astro';
import Section from '@/components/layout/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import CtaBand from '@/components/layout/CtaBand.astro';
import Calculator from '@/components/simulation/Calculator.astro';
import FaqSection from '@/components/content/FaqSection.astro';
import { lienEvaluation } from '@/config/site';
import { scenarioMisEnAvant } from '@/lib/simulations';

const data = await scenarioMisEnAvant();
---

<BaseLayout title={lienEvaluation.label} description="Estimez le potentiel d'automatisation d'une tâche à partir de vos propres hypothèses.">
  <PageHero eyebrow="Outil d'évaluation" breadcrumbs={[{ label: lienEvaluation.label, href: lienEvaluation.href }]}>
    <Fragment slot="title">Évaluer le potentiel <em class="accent">d'automatisation.</em></Fragment>
    Partez d'un scénario documenté et remplacez ses hypothèses par celles de votre activité.
  </PageHero>

  <Section tone="inverse" labelledby="calc-titre">
    <Calculator data={data} />
  </Section>

  <Section labelledby="lecture-titre">
    <SectionHeader eyebrow="Mode d'emploi" index="01" id="lecture-titre">
      <Fragment slot="title">Lire les résultats.</Fragment>
    </SectionHeader>
    <div class="lecture">
      <p class="lecture__avertissement">
        Les résultats reprennent uniquement les hypothèses affichées. Le temps estimé ne devient une économie que si le
        temps est réaffecté à une activité utile ou si une dépense est réellement évitée. Les coûts de projet et de
        fonctionnement sont fictifs tant qu'ils n'ont pas été remplacés par un devis ou des montants réels.
      </p>
      <dl class="lecture__notions">
        <div>
          <dt>Temps libéré</dt>
          <dd>Volume mensuel × durée moyenne × part automatisée.</dd>
        </div>
        <div>
          <dt>Valeur théorique du temps</dt>
          <dd>Temps libéré × coût horaire que vous avez choisi.</dd>
        </div>
        <div>
          <dt>Économie potentielle</dt>
          <dd>Valeur du temps × part réellement réaffectée, moins les coûts récurrents saisis.</dd>
        </div>
        <div>
          <dt>Retour net simulé</dt>
          <dd>Économies potentielles sur la période moins l'investissement initial.</dd>
        </div>
      </dl>
      <p>
        Ces étapes décrivent un calcul, pas une prévision. Ajustez une hypothèse à la fois et vérifiez les volumes et
        durées sur votre propre activité.
      </p>
    </div>
  </Section>

  <FaqSection index="02" />

  <CtaBand>
    <Fragment slot="title">Faire analyser <em class="accent">votre situation.</em></Fragment>
    Une estimation reste une estimation. Lors de l'analyse, nous mesurons vos volumes et vos coûts réels.
  </CtaBand>
</BaseLayout>

<style>
  .lecture {
    display: grid;
    gap: var(--space-5);
    max-width: 48rem;
  }

  .lecture__avertissement {
    color: var(--color-text-muted);
  }

  .lecture__notions {
    display: grid;
    gap: var(--space-4);
  }

  .lecture__notions dt {
    font-weight: 600;
  }

  .lecture__notions dd {
    margin: var(--space-1) 0 0;
    color: var(--color-text-muted);
  }
</style>

---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/layout/PageHero.astro';
import Section from '@/components/layout/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Button from '@/components/ui/Button.astro';
import Placeholder from '@/components/ui/Placeholder.astro';
import CtaBand from '@/components/layout/CtaBand.astro';
import SolutionCards from '@/components/content/SolutionCards.astro';
import CaseCards from '@/components/content/CaseCards.astro';
import FaqSection from '@/components/content/FaqSection.astro';
import TimeSimulator from '@/components/simulation/TimeSimulator.astro';
import FixedExample from '@/components/simulation/FixedExample.astro';
import { ctaPrincipal } from '@/config/site';

// Seuls les secteurs publiés ont une page (la santé attend sa validation).
export async function getStaticPaths() {
  const secteurs = await getCollection('secteurs', (s) => s.data.publie);
  return secteurs.map((secteur) => ({ params: { secteur: secteur.id }, props: { secteur } }));
}

interface Props {
  secteur: CollectionEntry<'secteurs'>;
}

const { secteur } = Astro.props;
const s = secteur.data;
// Sections rédigées pour ce secteur (src/content/pages-secteurs/) ; à défaut, sections génériques.
const page = (await getEntry('pagesSecteurs', secteur.id))?.data;
const valeur = page?.valeur;
const exigences = page?.exigences;
---

<BaseLayout title={s.nom} description={s.accroche}>
  <PageHero
    eyebrow="Secteur d'activité"
    breadcrumbs={[
      { label: 'Secteurs', href: '/secteurs/' },
      { label: s.nom, href: `/secteurs/${secteur.id}/` },
    ]}
  >
    <Fragment slot="title">{s.nom}</Fragment>
    {s.accroche}
    <Fragment slot="actions">
      <Button href={ctaPrincipal.href} arrow>{ctaPrincipal.label}</Button>
    </Fragment>
  </PageHero>

  <Section labelledby="problemes-titre">
    <SectionHeader eyebrow="Problèmes du métier" index="01" id="problemes-titre">
      <Fragment slot="title">Ce que nous rencontrons souvent.</Fragment>
    </SectionHeader>
    <ol class="problemes">
      {
        s.problemes.map((p, i) => (
          <li>
            <span class="mono">{String(i + 1).padStart(2, '0')}</span>
            {p}
          </li>
        ))
      }
    </ol>
  </Section>

  <Section tone="sunken" labelledby="solutions-titre">
    <SectionHeader eyebrow="Solutions correspondantes" index="02" id="solutions-titre">
      <Fragment slot="title">Les solutions adaptées.</Fragment>
    </SectionHeader>
    <SolutionCards ids={s.familles.map((f) => f.id)} />
  </Section>

  {
    valeur ? (
      <Section labelledby="valeur-titre">
        <SectionHeader eyebrow={valeur.eyebrow} index="03" id="valeur-titre">
          <Fragment slot="title">{valeur.titre}</Fragment>
          {valeur.lead}
        </SectionHeader>
        <TimeSimulator simulateur={valeur.simulateur} resultats={valeur.resultats} economie={valeur.economie} />
        <div class="valeur__suite">
          <FixedExample exemple={valeur.exemple} economie={valeur.economie} />
          <div class="valeur__conclusion">
            <p>{valeur.conclusion.titre}</p>
            <Button href={valeur.conclusion.cta.href} arrow>
              {valeur.conclusion.cta.label}
            </Button>
          </div>
        </div>
      </Section>
    ) : (
      <Section labelledby="cas-titre">
        <SectionHeader eyebrow="Cas pratiques" index="03" id="cas-titre">
          <Fragment slot="title">Exemples chiffrés.</Fragment>
        </SectionHeader>
        <CaseCards secteur={secteur.id} />
      </Section>
    )
  }

  {
    exigences ? (
      <Section labelledby="contraintes-titre">
        <SectionHeader eyebrow={exigences.eyebrow} index="04" id="contraintes-titre">
          <Fragment slot="title">{exigences.titre}</Fragment>
          {exigences.lead}
        </SectionHeader>
        <ul class="exigences">
          {exigences.items.map((x, i) => (
            <li>
              <span class="mono">{String(i + 1).padStart(2, '0')}</span>
              <h3>{x.titre}</h3>
              <p>{x.texte}</p>
            </li>
          ))}
        </ul>
      </Section>
    ) : (
      <Section labelledby="contraintes-titre">
        <SectionHeader eyebrow="Spécificités" index="04" id="contraintes-titre">
          <Fragment slot="title">Contraintes propres au métier.</Fragment>
        </SectionHeader>
        <Placeholder>Confidentialité, organisation, outils métier : ce qui conditionne les solutions dans ce secteur.</Placeholder>
      </Section>
    )
  }

  <FaqSection index="05" />
  <CtaBand />
</BaseLayout>

<style>
  .problemes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    padding: 0;
    border-top: 1px solid var(--color-line-strong);
    list-style: none;
  }

  .problemes li {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-5) var(--space-5) 0;
    border-bottom: 1px solid var(--color-line);
    font-size: var(--step-1);
    font-weight: 520;
    line-height: 1.25;
  }

  .problemes .mono {
    font-size: var(--step--2);
    font-weight: 400;
    color: var(--signal-600);
  }

  .valeur__suite {
    display: grid;
    gap: var(--space-5);
    align-items: center;
    margin-top: var(--space-6);
  }

  .valeur__conclusion {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .valeur__conclusion p {
    max-width: 24ch;
    font-family: var(--font-serif);
    font-size: var(--step-2);
    font-style: italic;
    line-height: 1.2;
    text-wrap: balance;
  }

  .exigences {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .exigences li {
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-5) var(--space-5);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-l);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .exigences .mono {
    font-size: var(--step--2);
    color: var(--signal-600);
  }

  .exigences h3 {
    font-size: var(--step-1);
    line-height: 1.2;
  }

  .exigences p {
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  @media (min-width: 56rem) {
    .valeur__suite {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  @media (min-width: 42rem) {
    .problemes li {
      padding-left: var(--space-5);
      border-left: 1px solid var(--color-line);
    }
  }
</style>

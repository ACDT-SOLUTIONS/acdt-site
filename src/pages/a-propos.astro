---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/layout/PageHero.astro';
import Section from '@/components/layout/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import CtaBand from '@/components/layout/CtaBand.astro';
import Orientation from '@/components/home/Orientation.astro';
---

<BaseLayout title="À propos" description="ACDT Solutions : analyse des problèmes métier, conception de solutions adaptées, mesure des résultats.">
  <PageHero eyebrow="À propos" breadcrumbs={[{ label: 'À propos', href: '/a-propos/' }]}>
    <Fragment slot="title">ACDT <em class="accent">Solutions.</em></Fragment>
    Analyse des problèmes métier, conception de solutions adaptées, mesure des résultats.
  </PageHero>

  <Section labelledby="approche-titre">
    <SectionHeader eyebrow="Notre approche" index="01" id="approche-titre">
      <Fragment slot="title">Une approche construite autour de votre travail réel.</Fragment>
    </SectionHeader>
    <div class="approche">
      <p>
        ACDT Solutions analyse les tâches répétitives et les points de friction avant de proposer une automatisation.
        L'objectif est de relier les outils déjà utiles, de réduire les manipulations manuelles et de conserver une
        validation humaine aux étapes qui l'exigent.
      </p>
      <p>
        Chaque projet commence par un besoin précis. Nous vérifions les outils, les données, les contraintes et les
        coûts, puis nous proposons un périmètre sur devis. Les résultats sont mesurés avec les indicateurs définis au
        départ ; ils ne sont pas promis à l'avance.
      </p>
      <p>
        ACDT Solutions propose quatre familles de solutions : accueil téléphonique, processus administratifs, CRM et
        automatisation commerciale, infrastructure privée. Les exemples du site sont identifiés comme scénarios
        lorsqu'ils ne décrivent pas un résultat client.
      </p>
      <p class="approche__appel">
        Vous avez un processus précis à examiner ? Présentez-nous son fonctionnement ; nous vous dirons si une étude a
        du sens.
      </p>
    </div>
  </Section>

  <Section tone="sunken" labelledby="activite-titre">
    <SectionHeader eyebrow="Notre activité" index="02" id="activite-titre">
      <Fragment slot="title">Ce que nous faisons.</Fragment>
    </SectionHeader>
    <Orientation />
  </Section>

  <CtaBand />
</BaseLayout>

<style>
  .approche {
    display: grid;
    gap: var(--space-4);
    max-width: 48rem;
  }

  .approche__appel {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    font-style: italic;
  }
</style>

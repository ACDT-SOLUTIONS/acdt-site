---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/layout/PageHero.astro';
import Section from '@/components/layout/Section.astro';
import Button from '@/components/ui/Button.astro';
import { ctaPrincipal, site } from '@/config/site';
---

<BaseLayout title="Contact" description="Contacter ACDT Solutions par email ou prendre rendez-vous.">
  <PageHero eyebrow="Contact" breadcrumbs={[{ label: 'Contact', href: '/contact/' }]}>
    <Fragment slot="title">Contacter <em class="accent">ACDT Solutions.</em></Fragment>
    Décrivez-nous votre situation par email, ou réservez directement un créneau d'échange.
  </PageHero>

  <Section labelledby="contact-titre">
    <h2 id="contact-titre" class="visually-hidden">Moyens de contact</h2>
    <ul class="moyens">
      <li class="moyen">
        <p class="moyen__label mono">Email</p>
        <a class="moyen__valeur" href={`mailto:${site.email}`}>{site.email}</a>
        <p>Précisez votre activité, vos outils actuels et ce qui vous fait perdre du temps.</p>
      </li>
      <li class="moyen">
        <p class="moyen__label mono">Rendez-vous</p>
        <p class="moyen__valeur">Un premier échange</p>
        <Button href={ctaPrincipal.href} variant="secondary" arrow>{ctaPrincipal.label}</Button>
      </li>
    </ul>
  </Section>
</BaseLayout>

<style>
  .moyens {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .moyen {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    justify-items: start;
    padding: var(--space-6);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-l);
    background: var(--color-surface);
  }

  .moyen__label {
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--signal-600);
  }

  .moyen__valeur {
    font-size: var(--step-2);
    font-weight: 560;
    overflow-wrap: anywhere;
  }

  .moyen p:not(.moyen__label):not(.moyen__valeur) {
    color: var(--color-text-muted);
  }
</style>

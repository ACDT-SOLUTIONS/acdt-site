# Copier en .env (non versionné). Ne JAMAIS placer de secret dans une variable PUBLIC_* :
# elles sont écrites en clair dans le HTML généré.

# false par défaut : meta robots noindex + robots.txt bloquant. À passer à true uniquement pour la production.
PUBLIC_INDEXABLE=false

# Google Analytics 4 (identifiant de l'ancien site : G-V9NGFLJYFW). Pris en compte uniquement en build de
# production ; chargé dans le navigateur seulement après consentement (public/consentement.js).
PUBLIC_GA4_ID=

# Formulaire de contact : vide = désactivé. Tests locaux : http://localhost:8787 (npm run formulaire:test).
# Le webhook n8n de production est défini dans .github/workflows/deploy.yml : ne pas l'utiliser en développement,
# chaque envoi déclenche les emails et l'écriture dans Google Sheets (voir DEPLOIEMENT.md, section 7).
PUBLIC_FORMULAIRE_URL=

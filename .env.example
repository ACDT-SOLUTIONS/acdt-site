# Copier en .env (non versionné). Ne JAMAIS placer de secret dans une variable PUBLIC_* :
# elles sont écrites en clair dans le HTML généré.

# false par défaut : meta robots noindex + robots.txt bloquant. À passer à true uniquement pour la production.
PUBLIC_INDEXABLE=false

# Plausible : chargé uniquement en build de production et si ces deux valeurs sont définies.
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_PLAUSIBLE_SRC=
